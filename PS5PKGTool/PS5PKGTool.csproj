<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PS5PKGTool</AssemblyName>
    <RootNamespace>PS5PKGTool</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Version>1.3.0</Version>
    <FileVersion>1.3.0.0</FileVersion>
    <Product>PS5 PKG Tool</Product>
    <Company>pearlxcore</Company>
    <Copyright>Copyright (c) pearlxcore</Copyright>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!--
      The views are driven from code behind and the data grids bind to row objects that are only
      known at run time, so compiled bindings cannot be used. See docs/AVALONIA_PORTING.md.
    -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <AvaloniaXamlIlDebuggerLaunch>false</AvaloniaXamlIlDebuggerLaunch>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="LibVLCSharp" Version="3.8.2" />
    <PackageReference Include="LibVLCSharp.Avalonia" Version="3.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PS5PKGTool.Core\PS5PKGTool.Core.csproj" />
    <ProjectReference Include="..\PS5PKGTool.Ffpfsc\PS5PKGTool.Ffpfsc.csproj" />
    <ProjectReference Include="..\PS5PKGTool.Ufs2\PS5PKGTool.Ufs2.csproj" />
  </ItemGroup>
  <!--
    Only the Oodle build for the host OS is shipped. Including both the Windows DLL and the
    Linux .so in every build put a foreign binary in the output folder and asked the runtime
    to load a library that cannot exist on that platform.
  -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Content Include="ThirdParty\Oodle\oo2core_9_win64.dll">
      <Link>oo2core_9_win64.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <Content Include="ThirdParty\Oodle\liboo2corelinux64.so.9">
      <Link>liboo2corelinux64.so.9</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Resources\*.png" />
    <AvaloniaResource Include="icon.ico" />
  </ItemGroup>
</Project>

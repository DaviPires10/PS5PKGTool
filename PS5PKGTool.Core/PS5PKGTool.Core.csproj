<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <PropertyGroup>
    <!--
      The PS5 package engines are compiled from source out of the upstream git submodules, so a
      clone that did not initialise them cannot build. The paths are kept in properties so the
      missing-submodule check below can name the exact folder to fetch.
    -->
    <ThirdPartyRoot>$(MSBuildThisFileDirectory)..\third_party\</ThirdPartyRoot>
    <ProsperoPkgToolProject>$(ThirdPartyRoot)ProsperoPkgTool\ProsperoPkgTool\ProsperoPkgTool.csproj</ProsperoPkgToolProject>
    <LibProsperoPkgProject>$(ThirdPartyRoot)LibProsperoPkg\src\LibProsperoPkg\LibProsperoPkg.csproj</LibProsperoPkgProject>
  </PropertyGroup>
  <ItemGroup>
    <!-- MIT/Unlicense codecs: BCnEncoder core for DDS/BC, SkiaSharp for PNG (also supplied by Avalonia). -->
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="Oodle.NET" Version="2.2.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PS5PKGTool.Ffpfsc\PS5PKGTool.Ffpfsc.csproj" />
    <ProjectReference Include="..\PS5PKGTool.Ufs2\PS5PKGTool.Ufs2.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(ProsperoPkgToolProject)" />
    <ProjectReference Include="$(LibProsperoPkgProject)" />
  </ItemGroup>
  <Target Name="CheckThirdPartySubmodules" BeforeTargets="ResolveProjectReferences">
    <Error Condition="!Exists('$(ProsperoPkgToolProject)')"
           Text="The ProsperoPkgTool submodule is missing. Run 'git submodule update --init --recursive' in $(MSBuildThisFileDirectory)../ to fetch it." />
    <Error Condition="!Exists('$(LibProsperoPkgProject)')"
           Text="The LibProsperoPkg submodule is missing. Run 'git submodule update --init --recursive' in $(MSBuildThisFileDirectory)../ to fetch it." />
  </Target>
</Project>
